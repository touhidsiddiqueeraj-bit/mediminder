    <!-- Privacy policy screen -->
    <string name="privacy_title">গোপনীয়তা নীতি</string>
    <string name="privacy_intro">মেডিমাইন্ডার এমনভাবে বানানো, যাতে আপনার স্বাস্থ্যের তথ্য আপনারই থাকে। আপনার তথ্যের কী হয়, তা সহজ ভাষায় এখানে লেখা হলো।</string>
    <string name="privacy_local_title">আপনার তথ্য আপনার ফোনেই থাকে</string>
    <string name="privacy_local_body">আপনার ওষুধ, রিমাইন্ডার ও ইতিহাস শুধুমাত্র এই ফোনেই একটি এনক্রিপ্ট করা ডেটাবেজে জমা থাকে। আপনার স্বাস্থ্যের তথ্য নেওয়ার মতো কোনো সার্ভার আমাদের কাছে নেই।</string>
    <string name="privacy_ocr_title">লেবেলের ছবি আপনার ফোনেই পড়া হয়</string>
    <string name="privacy_ocr_body">লেবেল বা প্রেসক্রিপশন স্ক্যান করলে ছবি তোলা ও লেখা পড়া — দুটোই আপনার ফোনেই হয়। একটি ছবিতে একাধিক ওষুধ থাকতে পারে — প্রতিটি আলাদাভাবে নিশ্চিত করবেন, আর চাইলে তথ্য সংরক্ষণের পরই ছবিটি মুছে ফেলতে পারবেন।</string>
    <string name="privacy_encryption_title">আপনার তথ্য এনক্রিপ্ট করা</string>
    <string name="privacy_encryption_body">ওষুধের ডেটাবেজ এনক্রিপ্ট করা থাকে, যার চাবি আপনার ফোনের হার্ডওয়্যার সিকিউরিটি মডিউল নিরাপদে রাখে।</string>
    <string name="privacy_network_title">একেবারেই ইন্টারনেট নেই</string>
    <string name="privacy_network_body">মেডিমাইন্ডারের কোনো ইন্টারনেট অনুমতি নেই, তাই এটি আপনার ওষুধ, ছবি বা ইতিহাস — কিছুই কাউকে পাঠাতে পারে না। স্ক্যান করা নাম ঠিক করতে সাহায্য করা ওষুধের নামের তালিকাটি অ্যাপের ভেতরেই থাকে এবং পুরোপুরি অফলাইনে কাজ করে।</string>
    <string name="privacy_no_tracking_title">বিজ্ঞাপন নেই, ট্র্যাকিং নেই</string>
    <string name="privacy_no_tracking_body">মেডিমাইন্ডারে কোনো বিজ্ঞাপন, অ্যানালিটিক্স বা তৃতীয় পক্ষের ট্র্যাকার নেই। আপনি কী করছেন, তা কেউ দেখছে না।</string>
    <string name="privacy_backup_title">স্বয়ংক্রিয় ক্লাউড ব্যাকআপ নেই</string>
    <string name="privacy_backup_body">আপনি নিজে এক্সপোর্ট না করা পর্যন্ত আপনার তথ্য কোনো ক্লাউডে ব্যাকআপ হয় না। অ্যাপটি মুছলে তথ্যও চলে যাবে — এটা নিয়ে দুশ্চিন্তা থাকলে নিজের এক্সপোর্ট রেখে দিন।</string>
    <string name="privacy_disclaimer_title">মনে করিয়ে দেওয়ার সাহায্য, ডাক্তার নয়</string>
    <string name="privacy_disclaimer_body">মেডিমাইন্ডার চিকিৎসা পরামর্শ দেয় না এবং কখনোই ডোজ বদলানোর কথা বলে না। ওষুধ নিয়ে যেকোনো প্রশ্নে সবসময় ডাক্তার বা ওষুধবিদকে জিজ্ঞেস করুন।</string>
