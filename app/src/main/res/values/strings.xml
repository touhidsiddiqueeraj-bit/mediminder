    <!-- Privacy policy screen -->
    <string name="privacy_title">Privacy policy</string>
    <string name="privacy_intro">We built MediMinder so that your health information belongs to you. Here is exactly what happens to your data, in plain language.</string>
    <string name="privacy_local_title">Your data stays on your phone</string>
    <string name="privacy_local_body">Your medicines, reminders and history are stored only on this phone, in a database that is encrypted. We have no servers that receive your health data.</string>
    <string name="privacy_ocr_title">Label photos are read on your phone</string>
    <string name="privacy_ocr_body">When you scan a medicine label or prescription, the photo and the text recognition both happen on your phone. A photo can contain several medicines — you confirm each one separately, and you can have the photo deleted right after the details are saved.</string>
    <string name="privacy_encryption_title">Your data is encrypted</string>
    <string name="privacy_encryption_body">The medicine database is encrypted with a key that is held securely by your phone\'s hardware security module.</string>
    <string name="privacy_network_title">No internet at all</string>
    <string name="privacy_network_body">MediMinder has no internet permission, so it cannot send anything — your medicines, photos or history — to anyone. The drug-name list that helps fix scanned names is packed inside the app and works completely offline.</string>
    <string name="privacy_no_tracking_title">No advertising, no tracking</string>
    <string name="privacy_no_tracking_body">MediMinder contains no ads, no analytics and no third-party trackers. Nobody is watching what you do.</string>
    <string name="privacy_backup_title">No automatic cloud backup</string>
    <string name="privacy_backup_body">Your data is not backed up to any cloud service unless you export it yourself. If you delete the app, its data is gone — please keep your own export if that worries you.</string>
    <string name="privacy_disclaimer_title">A reminder tool, not a doctor</string>
    <string name="privacy_disclaimer_body">MediMinder does not give medical advice and will never tell you to change your dose. For questions about your medicines, always ask your doctor or pharmacist.</string>
