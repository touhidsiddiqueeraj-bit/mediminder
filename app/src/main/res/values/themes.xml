<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the real UI; this is only the host activity theme.
         The AppCompat parent is required for per-app language switching
         (AppCompatDelegate.setApplicationLocales) on Android 8–12. -->
    <style name="Theme.MediMinder" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <style name="Theme.MediMinder.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MediMinder</item>
    </style>
</resources>
